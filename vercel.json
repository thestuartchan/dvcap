{
  "crons": [
    {
      "path": "/api/preread?region=asia&post=1&cron=1",
      "schedule": "42 22 * * 0-4"
    },
    {
      "path": "/api/preread?region=us&post=1&cron=1",
      "schedule": "42 12 * * 1-5"
    }
  ],
  "functions": {
    "api/preread.js": {
      "includeFiles": "data/render/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/g/:slug/:ticker",
      "destination": "/api/gex?feed=:slug&symbol=:ticker"
    },
    {
      "source": "/api/mcp/:token",
      "destination": "/api/gex?mcp=:token"
    }
  ]
}

{
  "crons": [
    {
      "path": "/api/regime-log?tick=1",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/preread.js": {
      "includeFiles": "data/render/**"
    },
    "api/regime-log.js": {
      "maxDuration": 300
    },
    "api/market.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/prices",
      "destination": "/api/market?route=prices"
    },
    {
      "source": "/api/atr",
      "destination": "/api/market?route=atr"
    },
    {
      "source": "/api/indicators",
      "destination": "/api/macro?route=indicators"
    },
    {
      "source": "/api/playbook",
      "destination": "/api/macro?route=playbook"
    },
    {
      "source": "/api/manual-entry",
      "destination": "/api/inputs?route=manual-entry"
    },
    {
      "source": "/api/korea-save",
      "destination": "/api/inputs?route=korea-save"
    },
    {
      "source": "/api/login",
      "destination": "/api/inputs?route=login"
    },
    {
      "source": "/api/ideas-card",
      "destination": "/api/tradecard?card=ideas"
    },
    {
      "source": "/api/event-card",
      "destination": "/api/tradecard?card=event"
    },
    {
      "source": "/api/g/:slug/:ticker",
      "destination": "/api/gex?feed=:slug&symbol=:ticker"
    },
    {
      "source": "/api/mcp/:token",
      "destination": "/api/gex?mcp=:token"
    },
    {
      "source": "/api/mcp/:token/",
      "destination": "/api/gex?mcp=:token&mcprest=/"
    },
    {
      "source": "/api/mcp/:token/:rest*",
      "destination": "/api/gex?mcp=:token&mcprest=:rest*"
    },
    {
      "source": "/api/book/:token",
      "destination": "/api/tradecard?bookmcp=:token"
    },
    {
      "source": "/api/book/:token/",
      "destination": "/api/tradecard?bookmcp=:token"
    },
    {
      "source": "/api/book/:token/:rest*",
      "destination": "/api/tradecard?bookmcp=:token"
    }
  ]
}

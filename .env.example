# .env.example — names only, placeholder values. Real values live in Vercel → Settings →
# Environment Variables, never in the repo. (.env* is git-ignored; this file is the exception.)

# The gamma MCP connector's path token: POST /api/mcp/<token> (lib/gammaMcp.js).
# 32+ random bytes, URL-safe. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Unset or shorter than 32 characters, the connector answers 404 to everyone.
# Rotate: set a new value in Vercel, redeploy, then edit the connector URL in claude.ai.
MCP_CONNECTOR_TOKEN=replace-with-32-plus-random-url-safe-characters
